# ============================================
# AI 台股全天候策略雷達與監控系統 - 環境變數設定
# ============================================
# 複製此檔為 .env 並填入你的 API Keys

# 伺服器設定
PORT=3001
DB_PATH=./data/radar.db

# Fugle 行情 API (https://developer.fugle.tw/)
FUGLE_API_KEY=your_fugle_api_key_here

# Gemini AI API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram 推播 (使用 @BotFather 建立 Bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# 交易參數
STOP_LOSS_PCT=-7.0
TAKE_PROFIT_PCT=15.0
MA5_EXIT=true
VOLUME_RATIO_THRESHOLD=2.5
BLUE_CHIP_TOP_N=50

# 掃描間隔 (分鐘)
RADAR_SCAN_INTERVAL_MIN=30
MONITOR_SCAN_INTERVAL_MIN=3
NEWS_SCAN_INTERVAL_MIN=10

# 台股交易時間
MARKET_OPEN=09:00
MARKET_CLOSE=13:30
